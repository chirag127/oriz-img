{
  "name": "oriz-img",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-side image toolkit — resize, crop, compress, convert (png/jpeg/webp), EXIF strip. 100% in-browser, no upload.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "icons": "node scripts/gen-icons.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "astro build && wrangler pages deploy dist --project-name oriz-img --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.0",
    "@chirag127/oz-ai": "file:../design-system/packages/oz-ai",
    "@chirag127/oz-chrome": "file:../design-system/packages/oz-chrome",
    "@chirag127/oz-file": "file:../design-system/packages/oz-file",
    "@chirag127/oz-tokens-base": "file:../design-system/packages/oz-tokens-base",
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.2.5",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^7.2.2",
    "browser-image-compression": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vite-pwa/astro": "^1.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
